# app.env.sample
# Copy to app.env and adjust values before starting the stack.
# These variables override the matching values in default.env for this app.
# No `export` prefix - this file is read by `docker compose --env-file`.

TZ=America/New_York
BASE_DOMAIN_NAME=example.com
BASE_HOST_NAME=speedtest.example.com

# Service user/group (uid/gid for the container)
SERVICE_USER=1000
SERVICE_GROUP=1000

# Application name shown in UI
APP_ORG_NAME=Speedtest Tracker

# Admin account credentials
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASS=replace-with-a-random-password
APP_SECRET_KEY=replace-with-a-random-32-byte-hex-string

# Dashboard settings
PUBLIC_DASHBOARD=true

# Cron schedule for running speed tests (default: every 4 hours)
SPEEDTEST_SCHEDULE=0 */4 * * *
